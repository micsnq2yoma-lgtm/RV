<mujoco model="RV nav arena">
  <!-- Navigation demo: a differential-drive robot in a 4 m x 3 m arena. Agent, perception and planning run on the RV board. -->
  <option timestep="0.002" integrator="implicitfast"/>
  <visual><global offwidth="640" offheight="480"/><headlight ambient=".32 .32 .32" diffuse=".38 .38 .38"/></visual>
  <default>
    <geom friction="1 .01 .001"/>
    <default class="wall"><geom type="box" rgba=".42 .42 .45 1"/></default>
    <default class="box"><geom type="box" rgba=".36 .30 .26 1" mass="20"/></default>
    <default class="pad"><geom type="box" contype="0" conaffinity="0"/></default>
  </default>
  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" diffuse=".6 .6 .6"/>
    <geom name="floor" type="plane" size="2.6 2.1 .1" rgba=".86 .85 .82 1"/>
    <!-- walls -->
    <geom class="wall" pos="0 1.55 .15" size="2.05 .05 .15"/>
    <geom class="wall" pos="0 -1.55 .15" size="2.05 .05 .15"/>
    <geom class="wall" pos="2.05 0 .15" size=".05 1.6 .15"/>
    <geom class="wall" pos="-2.05 0 .15" size=".05 1.6 .15"/>
    <!-- target zones (flat, no collision) -->
    <geom name="zone_red" class="pad" pos="1.55 1.05 .002" size=".3 .3 .002" rgba=".88 .18 .18 1"/>
    <geom name="zone_green" class="pad" pos="1.55 -1.05 .002" size=".3 .3 .002" rgba=".15 .70 .25 1"/>
    <geom name="zone_blue" class="pad" pos="-.25 1.05 .002" size=".3 .3 .002" rgba=".15 .35 .90 1"/>
    <geom name="zone_yellow" class="pad" pos=".15 -.05 .002" size=".35 .35 .002" rgba=".95 .80 .10 1"/>
    <geom name="zone_start" class="pad" pos="-1.55 -1.05 .002" size=".28 .28 .002" rgba=".70 .70 .72 1"/>
    <!-- static obstacles -->
    <body name="box1" pos="-.75 .1 .2"><geom class="box" size=".25 .45 .2"/></body>
    <body name="box2" pos=".95 .45 .2"><geom class="box" size=".2 .2 .2"/></body>
    <body name="box3" pos="1.0 -.95 .2"><geom class="box" size=".15 .35 .2"/></body>
    <!-- movable obstacle: parked below the floor, dropped into the path by the 'spawn_obstacle' event (scenario N4) -->
    <body name="box_dyn" mocap="true" pos="0 0 -1"><geom class="box" size=".25 .25 .2" rgba=".36 .30 .26 1" contype="1" conaffinity="1"/></body>
    <!-- robot: 40 x 30 cm differential drive; cyan front / magenta rear markers for board-side pose estimation -->
    <body name="robot" pos="-1.55 -1.05 .08">
      <freejoint name="robot_root"/>
      <geom name="chassis" type="box" size=".2 .15 .05" rgba=".95 .95 .95 1" mass="6"/>
      <geom name="mark_front" type="cylinder" pos=".11 0 .052" size=".06 .002" rgba="0 .85 .9 1" contype="0" conaffinity="0" mass=".01"/>
      <geom name="mark_rear" type="cylinder" pos="-.11 0 .052" size=".06 .002" rgba=".85 0 .75 1" contype="0" conaffinity="0" mass=".01"/>
      <geom name="caster_f" type="sphere" pos=".15 0 -.047" size=".03" friction="0 0 0" mass=".1"/>
      <geom name="caster_r" type="sphere" pos="-.15 0 -.047" size=".03" friction="0 0 0" mass=".1"/>
      <camera name="chase" pos="-.9 0 .55" xyaxes="0 -1 0 .45 0 .89" fovy="70"/>
      <body name="wheel_l" pos="0 .17 -.02"><joint name="wheel_l" type="hinge" axis="0 1 0" damping=".02" armature=".01"/><geom type="cylinder" size=".06 .02" euler="90 0 0" rgba=".15 .15 .15 1" friction="1.5 .01 .001" mass=".4"/></body>
      <body name="wheel_r" pos="0 -.17 -.02"><joint name="wheel_r" type="hinge" axis="0 1 0" damping=".02" armature=".01"/><geom type="cylinder" size=".06 .02" euler="90 0 0" rgba=".15 .15 .15 1" friction="1.5 .01 .001" mass=".4"/></body>
    </body>
    <camera name="top" pos="0 0 5.2" xyaxes="1 0 0 0 1 0" fovy="44"/>
    <camera name="front" pos="0 -3.9 3.1" xyaxes="1 0 0 0 .62 .78" fovy="55"/>
    <camera name="side" pos="4.3 0 3.0" xyaxes="0 1 0 -.58 0 .81" fovy="55"/>
  </worldbody>
  <actuator>
    <velocity name="drive_l" joint="wheel_l" kv="4" ctrlrange="-12 12"/>
    <velocity name="drive_r" joint="wheel_r" kv="4" ctrlrange="-12 12"/>
  </actuator>
</mujoco>
